# Required for the /manage editor in every environment.
PORTFOLIO_ADMIN_USERNAME=admin
PORTFOLIO_ADMIN_PASSWORD=replace-with-a-long-random-password
PORTFOLIO_ADMIN_SESSION_SECRET=replace-with-a-different-long-random-secret

# Add a Vercel Blob store to persist editor content and uploads on Vercel.
BLOB_READ_WRITE_TOKEN=

# Local/Docker fallback when BLOB_READ_WRITE_TOKEN is not set.
CONTENT_DIR=./content-data
FILE_HOSTING_MAX_MB=4
